{
  "name": "shared-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A todo list web app for two people, with offline use and sync through a small server",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && node scripts/postbuild.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "start": "node server/main.ts",
    "test": "vitest run",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "icons": "node scripts/make-icons.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
