{
  "id": "/",
  "name": "Shared Tasks",
  "short_name": "Tasks",
  "description": "A todo list for two people",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#111318",
  "theme_color": "#111318",
  "categories": ["productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New task",
      "url": "/?new=1",
      "icons": [{ "src": "/icons/shortcut-new-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New note",
      "url": "/?new=note",
      "icons": [{ "src": "/icons/shortcut-note-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
