# Copy this file to deploy/.env and set the values of your phone. deploy/.env is not in the repository.

# Address of the phone, for example its NordVPN Meshnet address
S22_HOST=100.x.y.z

# Port of the SSH server on the phone (Termux uses 8022)
S22_SSH_PORT=8022

# Private key that the phone accepts
S22_SSH_KEY=$HOME/.ssh/id_ed25519
